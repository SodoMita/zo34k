; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Тыквенная Ферма — zo34k"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.16, 0.08, 0.04, 1)
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=0

[autoload]

SettingsStore="*res://autoloads/settings_store.gd"
GameState="*res://autoloads/game_state.gd"
AudioDirector="*res://autoloads/audio_director.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
BrowserSaveSync="*res://autoloads/browser_save_sync.gd"

[dialogue_manager]

runtime/balloon_path="res://scenes/vn_balloon.tscn"
runtime/state_autoload_shortcuts=PackedStringArray("GameState")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

